<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true"
    android:paddingBottom="4dp"
    android:paddingEnd="4dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivStoryProfilePic"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_default_profile_placeholder"
        app:civ_border_color="@android:color/darker_gray"
        app:civ_border_width="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivAddStoryButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_add_circle_black_24dp"
        android:background="@drawable/circle_background_white"
        android:padding="2dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="@+id/ivStoryProfilePic"
        app:layout_constraintBottom_toBottomOf="@+id/ivStoryProfilePic"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:contentDescription="Add to story" />

    <TextView
        android:id="@+id/tvStoryUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Your Story"
        android:textColor="@android:color/black"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@+id/ivStoryProfilePic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>