<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@android:color/white">

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Map"
        android:textColor="@android:color/black" android:textSize="40sp" android:textStyle="bold"
        android:layout_gravity="top|start"
        android:layout_marginTop="32dp" android:layout_marginStart="16dp" android:elevation="4dp" />

    <ImageView
        android:id="@+id/ivProfileIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_default_profile_placeholder"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_background_white" android:padding="2dp" android:elevation="4dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="User Profile" />
</FrameLayout>