<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment"> <fragment
    android:id="@+id/recordFragment"
    android:name="com.example.walkfie.RecordFragment"
    android:label="Record"
    tools:layout="@layout/fragment_record">
    <action
        android:id="@+id/action_recordFragment_to_profileFragment"
        app:destination="@id/profileFragment" />
</fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.walkfie.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.walkfie.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_addStoryFragment"
            app:destination="@id/addStoryFragment" />
        <action
            android:id="@+id/action_homeFragment_to_createPostFragment"
            app:destination="@id/createPostFragment" />
        <action
            android:id="@+id/action_homeFragment_to_findFriendsFragment"
            app:destination="@id/findFriendsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/addStoryFragment"
        android:name="com.example.walkfie.AddStoryFragment"
        android:label="AddStory"
        tools:layout="@layout/fragment_add_story" />

    <fragment
        android:id="@+id/createPostFragment"
        android:name="com.example.walkfie.CreatePostFragment"
        android:label="CreatePost"
        tools:layout="@layout/fragment_create_post" />

    <fragment
        android:id="@+id/findFriendsFragment"
        android:name="com.example.walkfie.FindFriendsFragment"
        android:label="FindFriends"
        tools:layout="@layout/fragment_find_friends" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.walkfie.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_savedPostsFragment"
            app:destination="@id/savedPostsFragment" />
    </fragment>
    <fragment
        android:id="@+id/savedPostsFragment"
        android:name="com.example.walkfie.SavedPostsFragment"
        android:label="Saved Posts"
        tools:layout="@layout/fragment_saved_posts" />

</navigation>